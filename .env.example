# 复制为 .env 后按需修改（.env 不要提交到 git）
FM_PORT=4174
TZ=Asia/Shanghai

# 访问令牌：生成一个随机串填进来，客户端/网页端填同一个值
# Linux: openssl rand -hex 24   Windows PowerShell:
#   -join ((48..57)+(97..122) | Get-Random -Count 32 | % {[char]$_})
FM_TOKEN=换成你的随机令牌

# NAS 没有外网时，关掉商品图抓取
# AUTO_PRODUCT_IMAGES=off
# PRODUCT_IMAGES=off
# 没有 python3+Pillow（自建镜像）时可关掉主色校验
# PRODUCT_IMAGE_COLOR_CHECK=off
